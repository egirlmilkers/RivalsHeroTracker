					},
					h('span', {
						style: {
							position: 'absolute',
							top: '-17px',
							color: '#999',
							fontSize: '0.7em'
						}
					}, 'Level'),
					h('input', {
						type: 'number',
						class: 'level-input',
						min: '1',
						max: '70',
						value: String(levelInfo.level),
						onchange: (e: Event) =>
							updateHero(
								hero.name,
								'level',
								parseInt((e.target as HTMLInputElement).value)
							)
