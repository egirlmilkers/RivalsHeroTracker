:root {
	--bg-color: #0a0a0a;
	--card-bg: #141414;
	--text-color: #e0e0e0;
	--input-bg: #262626;
	--border-color: #333;
	/* Rank Colors */
	--color-agent: #8f7c5d;

	--color-knight: #737890;
	--glow-knight: #b4c1cb99;

	--color-captain: #5e8795;
	--glow-captain: #94c2cc;

	--color-centurion: #6c80a0;
	--glow-centurion: #8bb2e7;

	--color-lord: #ffce76;
	--glow-lord: #7f6b56;

	--color-count: #8fcdd8;
	--glow-count: #c0f5ff;

	--color-colonel: #74b4de;
	--glow-colonel: #a8defc;

	--color-warrior: #c982f3;
	--glow-warrior: #e5b6fa;

	--color-elite: #f87940;
	--glow-elite: #f7925d;

	--color-guardian: #eb79dd;
	--glow-guardian: #ffb2f8;

	--color-champion: #f62a42;
	--glow-champion: #f7cd35;

	--color-gold: #d5a246;
}

body {
	display: flex;
	flex-direction: column;
	align-items: center;
	margin: 0;
	padding: 20px;
	background-color: var(--bg-color);
	color: var(--text-color);
	font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

h1 {
	margin-bottom: 20px;
	color: var(--text-color);
	font-weight: 300;
	letter-spacing: 2px;
	text-align: center;
	text-transform: uppercase;
}

h3 {
	margin-top: 0;
	margin-bottom: 40px;
	color: var(--border-color);
	font-weight: 300;
	font-size: medium;
	letter-spacing: 1px;
	text-align: center;
	text-transform: uppercase;
}

.controls {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	margin-bottom: 20px;
	gap: 10px;
}

button {
	padding: 10px 20px;
	border: none;
	border-radius: 4px;
	font-weight: bold;
	font-family: inherit;
	cursor: pointer;
	transition: background .2s, transform .1s;
}

button:active {
	transform: scale(.98);
}

button:disabled {
	transform: none;
	cursor: not-allowed;
	opacity: .5;
}

.btn-sort {
	background-color: var(--color-knight);
	box-shadow: 0 0 10px var(--glow-knight);
	color: #000;
}

.btn-sort:hover {
	background-color: #66e0ff;
}

.btn-reset {
	align-self: center;
	max-width: 10rem;
	padding: 5px 10px;
	background-color: #333;
	color: #f98284;
}

.btn-reset:hover {
	background-color: #a10003;
}

.btn-share {
	background-color: #6c5671;
	color: #000;
}

.btn-share:hover {
	background-color: #b0a9e4;
}

.btn-settings {
	padding: 0;
	background-color: transparent;
	color: #ccc;
	font-size: 1.6rem;
}

.container {
	width: 100%;
	max-width: 950px;
	margin-bottom: 30px;
	padding: 25px;
	border: 1px solid var(--border-color);
	border-radius: 12px;
	background-color: var(--card-bg);
	box-shadow: 0 10px 30px rgba(0, 0, 0, .7);
}

.hero-row {
	display: grid;
	grid-template-columns: 70px 2.5fr 1.1fr 1fr;
	align-items: center;
	padding: 15px 5px;
	gap: 15px;
	border-bottom: 1px solid var(--border-color);
	transition: background .2s;
}

.hero-row:hover {
	background-color: rgba(255, 255, 255, .02);
}

.hero-row:last-child {
	border-bottom: none;
}

/* Image Styles */
.portrait-container {
	position: relative;
}

.char-img-wrapper {
	width: 70px;
	height: 70px;
	overflow: hidden;
	border-radius: 12px;
}

.hero-portrait {
	width: 100%;
	height: 100%;
	object-fit: cover;
}

.role-icon-container {
	display: flex;
	z-index: 2;
	position: absolute;
	right: -10px;
	bottom: -10px;
	justify-content: end;
	width: 24px;
	height: 24px;
	padding: 2px;
	border-radius: 50%;
}

.role-icon-mini {
	filter: drop-shadow(0 0 3px rgba(0, 0, 0, .8));
}

.rank-badge-img {
	width: auto;
	height: 40px;
	margin-right: 15px;
	vertical-align: middle;
	filter: drop-shadow(0 0 5px rgba(0, 0, 0, .5));
}

.hero-details {
	display: flex;
	flex-direction: column;
	justify-content: center;
	min-width: 0;
}

.hero-name {
	display: flex;
	align-items: center;
	margin-bottom: 4px;
	font-weight: 600;
	font-size: 1.2em;
	transition: all .4s ease-out;
}

/* Progress Bar Styles */
.progress-section {
	display: flex;
	flex-direction: column;
	margin-top: 4px;
	gap: 4px;
}

.progress-label {
	display: flex;
	justify-content: space-between;
	margin-bottom: 2px;
	color: #888;
	font-size: .7em;
}

.progress-bg {
	position: relative;
	width: 100%;
	height: 6px;
	overflow: hidden;
	border-radius: 3px;
	background-color: #333;
}

.progress-fill {
	height: 100%;
	border-radius: 3px;
	transition: width .5s ease-in-out;
}

/* Dynamic Progress Colors */
.fill-next-Knight {
	background-color: var(--color-knight);
	box-shadow: 0 0 5px var(--glow-knight);
}

.fill-next-Captain {
	background-color: var(--color-captain);
	box-shadow: 0 0 5px var(--glow-captain);
}

.fill-next-Centurion {
	background-color: var(--color-centurion);
	box-shadow: 0 0 5px var(--glow-centurion);
}

.fill-next-Lord {
	background-color: var(--color-lord);
	box-shadow: 0 0 5px var(--glow-lord);
}

.fill-next-Count {
	background-color: var(--color-count);
	box-shadow: 0 0 5px var(--glow-count);
}

.fill-next-Colonel {
	background-color: var(--color-colonel);
	box-shadow: 0 0 5px var(--glow-colonel);
}

.fill-next-Warrior {
	background-color: var(--color-warrior);
	box-shadow: 0 0 5px var(--glow-warrior);
}

.fill-next-Elite {
	background-color: var(--color-elite);
	box-shadow: 0 0 5px var(--glow-elite);
}

.fill-next-Guardian {
	background-color: var(--color-guardian);
	box-shadow: 0 0 5px var(--glow-guardian);
}

.fill-next-Champion {
	background-color: var(--color-champion);
	box-shadow: 0 0 5px var(--glow-champion);
}

.fill-next-Agent {
	background-color: var(--color-agent);
}

.fill-total {
	background: linear-gradient(90deg, #444, var(--color-lord));
}

.rank-select-container {
	display: flex;
	align-items: center;
	justify-content: center;
}

/* Rank Text Colors */
.rank-Agent {
	color: var(--color-agent);
}

.rank-Knight {
	color: var(--color-knight);
	text-shadow: 0 0 10px var(--glow-knight);
}

.rank-Captain {
	color: var(--color-captain);
	text-shadow: 0 0 12px var(--glow-captain);
}

.rank-Centurion {
	color: var(--color-centurion);
	text-shadow: 0 0 14px var(--glow-centurion);
}

.rank-Lord {
	color: var(--color-lord);
	text-shadow: 0 0 16px var(--glow-lord);
}

.rank-Count {
	color: var(--color-count);
	text-shadow: 0 0 16px var(--glow-count);
}

.rank-Colonel {
	color: var(--color-colonel);
	text-shadow: 0 0 18px var(--glow-colonel);
}

.rank-Warrior {
	color: var(--color-warrior);
	text-shadow: 0 0 18px var(--glow-warrior);
}

.rank-Elite {
	color: var(--color-elite);
	text-shadow: 0 0 20px var(--glow-elite);
}

.rank-Guardian {
	color: var(--color-guardian);
	text-shadow: 0 0 20px var(--glow-guardian);
}

.rank-Champion {
	color: var(--color-champion);
	text-shadow: 0 0 22px var(--glow-champion);

	& img {
		transform: scale(2);
	}
}

select, input {
	box-sizing: border-box;
	width: 100%;
	padding: 10px;
	border: 1px solid var(--border-color);
	border-radius: 6px;
	background-color: var(--input-bg);
	color: white;
	font-size: .95em;
	font-family: inherit;
}

/* Specific styling for the new Level Input */
.level-input {
	display: flex;
	padding: 8px;
}

select {
	cursor: pointer;
}

select:hover, input:hover {
	border-color: #555;
}

.point-container {
	display: flex;
	align-items: center;
	gap: 8px;
}

.point-suffix {
	color: #999;
	font-weight: 600;
	font-size: .85em;
	white-space: nowrap;
}

.header-row {
	grid-template-columns: 70px 2.5fr 1.2fr 1fr;
	margin-bottom: 10px;
	padding-bottom: 15px;
	border-bottom: 2px solid var(--border-color);
	color: #666;
	font-weight: 700;
	font-size: .85em;
	letter-spacing: 1px;
	text-transform: uppercase;
}

/* Backup Section Styles */
.backup-section {
	width: 100%;
	max-width: 900px;
	margin-bottom: 50px;
	padding: 20px;
	border: 1px solid #333;
	border-radius: 8px;
	background-color: #1a1a1a;
	box-shadow: 0 5px 15px rgba(0, 0, 0, .5);
	color: #888;
	text-align: center;
}

.backup-title {
	margin-bottom: 15px;
	color: #fff;
	font-weight: bold;
	font-size: .9em;
	letter-spacing: 1px;
	text-transform: uppercase;
}

.backup-controls {
	display: flex;
	align-items: center;
	justify-content: center;
	gap: 15px;
}

.btn-backup {
	border: 1px solid #444;
	background-color: #333;
	color: #ccc;
	font-size: .9em;
}

.btn-backup:hover {
	border-color: var(--color-knight);
	background-color: var(--color-knight);
	color: #000;
}

#fileInput {
	display: none;
}

/* >> Filter Styles << */
.filter-container {
	width: 100%;
	max-width: 950px;
	margin-bottom: 20px;
	overflow: hidden;
	border: 1px solid var(--border-color);
	border-radius: 8px;
	background-color: var(--card-bg);
	transition: border-color .3s;
}

.filter-container:hover {
	border-color: #555;
}

.btn-filter-toggle {
	display: flex;
	align-items: center;
	width: 100%;
	gap: 10px;
	background: transparent;
	color: #888;
	font-weight: 500;
	/* padding: 12px 20px; */
	font-size: .9em;
	letter-spacing: 1px;
	text-align: left;
	text-transform: uppercase;
}

.btn-filter-toggle:hover {
	background-color: rgba(255, 255, 255, .02);
	color: #fff;
}

#filter-arrow {
	font-size: .8em;
	transition: transform .3s ease;
}

.filter-content {
	max-height: 0;
	overflow: hidden;
	background-color: rgba(0, 0, 0, .2);
	opacity: 0;
	transition: max-height .3s ease-out, opacity .3s ease-out;
}

.filter-content.expanded {
	max-height: 150px;
	/* Adjust if content grows */
	opacity: 1;
}

.filter-inner {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	padding: 15px 20px;
	gap: 20px;
	border-top: 1px solid var(--border-color);
}

#searchInput {
	flex: 1;
	min-width: 200px;
	border: 1px solid #333;
	background-color: #000;
}

#searchInput:focus {
	border-color: var(--color-knight);
	outline: none;
}

.role-filters {
	display: flex;
	gap: 15px;
}

.role-checkbox {
	display: flex;
	align-items: center;
	gap: 8px;
	color: #bbb;
	cursor: pointer;
	user-select: none;
}

.role-checkbox:hover {
	color: #fff;
}

.role-checkbox input {
	width: 16px;
	height: 16px;
	accent-color: var(--color-knight);
	cursor: pointer;
}

/* >> Modal Styles << */
.modal-overlay {
	display: flex;
	z-index: 1000;
	position: fixed;
	top: 0;
	left: 0;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 100%;
	backdrop-filter: blur(4px);
	background: rgba(0, 0, 0, .85);
}

.modal-content {
	position: relative;
	width: 90%;
	max-width: 600px;
	padding: 30px;
	border: 1px solid var(--border-color);
	border-radius: 12px;
	background: var(--card-bg);
	box-shadow: 0 10px 40px rgba(0, 0, 0, .8);
	text-align: center;
}

.modal-content h2 {
	margin-top: 0;
	color: #fff;
	letter-spacing: 1px;
}

.comparison-container {
	display: flex;
	margin-top: 20px;
	gap: 20px;
}

.save-option {
	display: flex;
	flex: 1;
	flex-direction: column;
	justify-content: space-between;
	padding: 15px;
	border: 1px solid #333;
	border-radius: 8px;
	background: var(--input-bg);
}

.save-option h3 {
	margin-bottom: 15px;
}

.top-heroes-list {
	min-height: 120px;
	margin-bottom: 20px;
	padding: 10px;
	border-radius: 6px;
	background: rgba(0, 0, 0, .2);
	font-size: .9em;
	text-align: left;
}

.top-hero-item {
	display: flex;
	justify-content: space-between;
	padding: 6px 0;
	border-bottom: 1px solid #333;
}

.top-hero-item:last-child {
	border-bottom: none;
}

/* >> Share Image Modal Styles << */
.share-canvas-wrapper {
	display: flex;
	position: relative;
	justify-content: center;
	width: 100%;
	min-height: 120px;
	overflow: hidden;
	border-radius: 10px;
	background: #000;
}

#share-canvas {
	display: block;
	width: 100%;
	height: auto;
}

.share-loading {
	display: flex;
	position: absolute;
	top: 0;
	left: 0;
	align-items: center;
	justify-content: center;
	width: 100%;
	height: 100%;
	background: rgba(0, 0, 0, .4);
	color: #888;
	font-size: .9em;
	letter-spacing: 1px;
	text-transform: uppercase;
}

.share-loading.hidden {
	display: none;
}

.share-modal-actions {
	display: flex;
	justify-content: center;
	margin-top: 20px;
	gap: 15px;
}

/* >> Settings Modal Styles << */
.settings-list {
	display: flex;
	flex-direction: column;
	gap: 12px;
	text-align: left;
}

.settings-row {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 14px 16px;
	gap: 20px;
	border: 1px solid #333;
	border-radius: 8px;
	background: var(--input-bg);
	cursor: pointer;
}

.settings-row:hover {
	border-color: #555;
}

.settings-row-text {
	display: flex;
	flex-direction: column;
	gap: 4px;
}

.settings-row-title {
	color: #fff;
	font-weight: 600;
	font-size: .95em;
}

.settings-row-desc {
	color: #888;
	font-size: .8em;
}

/* Base styling for the checkbox input */
.settings-row input[type='checkbox'] {
	appearance: none;
	-webkit-appearance: none;

	width: 1.25em;
	height: 1.25em;
	border: 2px solid #9ca3af;
	border-radius: 4px;
	background-color: transparent;
	cursor: pointer;

	display: inline-grid;
	position: relative;
	place-content: center;
	vertical-align: middle;
}

.settings-row input[type='checkbox']:checked {
	border-color: #4f46e5;
	background-color: #4f46e5;
}

.settings-row input[type='checkbox']::before {
	width: .65em;
	height: .35em;
	transform: rotate(-45deg) translate(1px, -1px);
	border-bottom: 2px solid #fff;
	border-left: 2px solid #fff;
	content: '';

	opacity: 0;
	transition: opacity .1s ease-in-out;
}

.settings-row input[type='checkbox']:checked::before {
	opacity: 1;
}

.settings-row input[type='checkbox']:focus-visible {
	outline: 2px solid #2563eb;
	outline-offset: 2px;
}

/* >> Pin Button Styles << */
.pin-btn {
	display: inline-block;
	margin-left: 8px;
	color: #fff1;
	font-size: 1em;
	cursor: pointer;
	transition: color .2s, transform .2s;
	user-select: none;
}

.pin-btn:hover {
	transform: scale(1.1);
	color: #fff !important;
}

.pin-btn.pinned {
	color: #a2a2a2;
	text-shadow: 0 0 8px;
}

/* >> Version & Changelog Styles << */
.version-display {
	position: absolute;
	top: 10px;
	right: 10px;
	color: #666;
	font-weight: 600;
	font-size: .9em;
	letter-spacing: 1px;
	cursor: pointer;
	transition: color .2s ease, transform .2s ease;
}

/* Custom Markdown styling overrides for the modal */
.modal-content {
	max-width: 600px;
	max-height: 85vh;
	overflow-y: auto;
	text-align: left;
}

#changelog-title {
	margin-bottom: -15px;
	text-align: center;
}

#changelog-body ul {
	margin-top: 8px;
	padding-left: 20px;
	color: #bbb;
}

#changelog-body li {
	margin-bottom: 6px;
	line-height: 1.4;
}

#changelog-body blockquote {
	margin: 12px 0;
	padding-top: 8px;
	padding-bottom: 8px;
	padding-left: 12px;
	border-left: 3px solid var(--color-knight);
	border-radius: 0 4px 4px 0;
	background: rgba(255, 255, 255, .03);
	color: #999;
	font-style: italic;
}

.cl-headers {
	margin-top: 40px;
	margin-bottom: 8px;
	padding-bottom: 6px;
	border-bottom: 1px solid #333;
	color: #fac53c;
	font-variant: small-caps;
	font-size: 1.2em;
	text-transform: none;
	/* font-weight: 600; */
}

.cl-headers span {
	margin-left: 10px;
	color: #777;
	font-weight: normal;
	font-size: .75em;
	text-transform: uppercase;
}

div:has(> .close-btn) {
	text-align: end;
}

.close-btn {
	position: absolute;
	top: 15px;
	right: 20px;
	padding: 2px;
	background-color: transparent;
	color: #777;
	font-size: 2rem;
}

.hover-btn {
	transition: color .2s ease, transform .2s ease;

	&:hover {
		transform: scale(1.05);
		color: #fff;
	}
}

/* >> Scrollbar Styles << */
html, .no-scroll-track {
	overflow-y: auto;
	scrollbar-color: #888 transparent;
	/* Firefox */
	scrollbar-width: thin;

	/* Chrome, Edge, Safari */
	&::-webkit-scrollbar {
		width: 8px;
	}

	&::-webkit-scrollbar-track {
		background: transparent;
	}

	&::-webkit-scrollbar-thumb {
		border-radius: 4px;
		background: #888;
	}

	&::-webkit-scrollbar-thumb:hover {
		background: #555;
	}
}

/* >> Mobile Styles << */
@media (max-width: 600px) {
	.hero-row {
		/* Define a 2-column, 2-row grid */
		display: grid;
		grid-template-rows: auto auto;
		grid-template-columns: 80px 1fr;
		margin-bottom: 10px;
		/* Added more vertical gap to account for the "Level" label */
		padding: 15px;
		gap: 20px 15px;
		border: 1px solid #333;
		border-radius: 8px;
		background: #1a1a1a;
	}

	/* Row 1: Portrait and Name/Bars */
	.portrait-container {
		grid-row: 1;
		grid-column: 1;
	}

	.hero-details {
		display: flex;
		grid-row: 1;
		grid-column: 2;
		flex-direction: column;
		justify-content: center;
	}

	/* Row 2: Level Input and XP Input */
	.rank-select-container {
		grid-row: 2;
		grid-column: 1;
		justify-content: flex-start;
		/* Align to the left under the portrait */
	}

	.point-container {
		grid-row: 2;
		grid-column: 2;
		align-items: center;
	}

	/* UI Adjustments for small screens */
	.header-row {
		display: none;
		/* Keep headers hidden on mobile */
	}

	.rank-badge-img {
		height: 30px;
		/* Shrink badge slightly to fit the column width */
		margin-right: 8px;
	}

	.hero-name {
		font-size: 1.1em;
	}

	/* Ensure inputs take up appropriate space */
	.point-container input {
		flex: 1;
	}
}
